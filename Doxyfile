# @file Doxyfile
# @brief Configuración de Doxygen para generar la documentación del código.
# @author Santiago Caicedo
#
# Uso:       doxygen Doxyfile        (o: cmake --build build --target docs)
# Resultado: docs/api/html/index.html
#
# Es estricta a propósito: avisa de cualquier clase, función o parámetro sin documentar,
# y la CI falla si aparece un aviso. Así la documentación nunca se queda atrás del código.

PROJECT_NAME           = "Sistema de Almacén"
PROJECT_BRIEF          = "Ventas, clientes, productos y almacenes con arquitectura limpia"
PROJECT_NUMBER         = 2.1.0
OUTPUT_DIRECTORY       = docs/api
OUTPUT_LANGUAGE        = Spanish
INPUT                  = README.md src docs/ARQUITECTURA.md docs/DESARROLLO.md docs/MANUAL_USUARIO.md CHANGELOG.md
RECURSIVE              = YES
FILE_PATTERNS          = *.hpp *.cpp *.md
USE_MDFILE_AS_MAINPAGE = README.md
IMAGE_PATH             = docs/capturas
MARKDOWN_SUPPORT       = YES

# Qué se documenta
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
JAVADOC_AUTOBRIEF      = YES
SORT_MEMBER_DOCS       = NO

# Avisos: todo lo público debe estar documentado, con sus parámetros y su valor de retorno
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = NO

# Salida
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
SOURCE_BROWSER         = YES
HTML_COLORSTYLE        = LIGHT

# Diagramas de clases y de dependencias (requieren Graphviz; si no está, se omiten)
HAVE_DOT               = YES
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
INCLUDE_GRAPH          = NO
INCLUDED_BY_GRAPH      = NO
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
